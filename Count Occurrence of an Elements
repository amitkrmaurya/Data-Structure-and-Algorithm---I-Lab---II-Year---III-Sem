#include <stdio.h>

int main() {
    int n, i, x, count = 0;

    scanf("%d", &n);
    int arr[n];

    // Read array elements
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Read element to count
    scanf("%d", &x);

    // Count occurrences
    for (i = 0; i < n; i++) {
        if (arr[i] == x) {
            count++;
        }
    }

    // Print result
    printf("%d\n", count);

    return 0;
}

