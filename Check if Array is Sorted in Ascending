#include <stdio.h>

int main() {
    int n, i;
    scanf("%d", &n);

    int arr[n];

    // Read array elements
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Check if array is sorted in ascending order
    int isSorted = 1;  // 1 means true, 0 means false
    for (i = 0; i < n - 1; i++) {
        if (arr[i] > arr[i + 1]) {
            isSorted = 0;
            break;
        }
    }

    // Print result
    if (isSorted) {
        printf("True\n");
    } else {
        printf("False\n");
    }

    return 0;
}

