#include <stdio.h>
#include <stdlib.h>

// Node structure
struct Node {
    int data;
    struct Node* prev;
    struct Node* next;
};

// Function to insert at the end
void insertEnd(struct Node** head, int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->next = NULL;
    newNode->prev = NULL;

    if (*head == NULL) {
        *head = newNode;
        return;
    }

    struct Node* temp = *head;
    while (temp->next != NULL)
        temp = temp->next;

    temp->next = newNode;
    newNode->prev = temp;
}

// Function to reverse and print the doubly linked list
void reversePrint(struct Node* head) {
    if (head == NULL)
        return;

    struct Node* temp = head;
    // Go to last node
    while (temp->next != NULL)
        temp = temp->next;

    // Print in reverse
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->prev;
    }
}

