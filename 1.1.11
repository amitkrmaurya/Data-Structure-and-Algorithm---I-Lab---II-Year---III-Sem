#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    int arr[n], i, j, x, ni, pos;

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &x);

    // Sort the array first (Bubble sort)
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    // Binary Search
    i = 0, j = n - 1;
    int flag = 0;

    while (i <= j) {
        int mid = (i + j) / 2;

        if (arr[mid] == x) {
            ni = mid; // or pos = mid + 1;
            flag = 1;
            break;
        } else if (arr[mid] > x) {
            j = mid - 1;
        } else {
            i = mid + 1;
        }
    }

    if (flag == 1) {
        printf("%d", ni);
    } else {
        printf("-1");
    }

    return 0;
}
