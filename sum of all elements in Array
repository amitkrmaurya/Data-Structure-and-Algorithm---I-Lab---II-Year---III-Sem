#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int arr[n];
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Print array in the required format
    printf("[");
    for(int i = 0; i < n; i++) {
        printf("%d", arr[i]);
        if(i != n-1) {
            printf(", ");
        }
    }
    printf("]\n");

    // Calculate sum
    int sum = 0;
    for(int i = 0; i < n; i++) {
        sum += arr[i];
    }

    // Print sum
    printf("%d\n", sum);

    return 0;
}

