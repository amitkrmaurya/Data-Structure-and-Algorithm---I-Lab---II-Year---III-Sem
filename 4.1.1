#include <stdio.h>

#define MAX 1000

int main() {
    int queue[MAX];
    int front = 0, rear = -1;
    int n, op, val;

    // Read number of operations
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &op);

        if (op == 1) {
            // Enqueue
            scanf("%d", &val);
            if (rear < MAX - 1) {
                rear++;
                queue[rear] = val;
            }
        } else if (op == 2) {
            // Dequeue
            if (front <= rear) {
                front++;
            }
        }
    }

    // Print queue contents
    if (front > rear) {
        printf("Empty\n");
    } else {
        for (int i = front; i <= rear; i++) {
            printf("%d", queue[i]);
            if (i != rear) {
                printf(" ");
            }
        }
        printf("\n");
    }

    return 0;
}

